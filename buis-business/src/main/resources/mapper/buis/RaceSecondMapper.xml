<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.RaceSecondMapper">
    
    <resultMap type="com.buis.vo.RaceSecondVo" id="RaceSecondResult">
        <result property="id"    column="id"    />
        <result property="race"    column="race"    />
        <result property="name"    column="name"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="raceName" column="race_name"/>
    </resultMap>

    <sql id="selectRaceSecondVo">
        select t1.id,
               t1.race,
               t1.name,
               t1.start_time,
               t1.end_time,
               t1.update_time,
               t1.create_time,
               t1.is_deleted,
               t2.name as race_name
        from race_second t1
                 left join race_info t2 on t1.race = t2.id
    </sql>

    <select id="selectRaceSecondList" parameterType="com.buis.vo.RaceSecondVo" resultMap="RaceSecondResult">
        <include refid="selectRaceSecondVo"/>
        <where>
            t1.is_deleted = 0
            <if test="name != null  and name != ''"> and t1.name like concat('%', #{name}, '%')</if>
             <if test="race != null "> and t1.race = #{race}</if>
            <if test="startTime != null "> and t1.start_time = #{startTime}</if>
            <if test="endTime != null "> and t1.end_time = #{endTime}</if>
            <if test="isDeleted != null "> and t1.is_deleted = #{isDeleted}</if>
        </where>
    </select>
    
    <select id="selectRaceSecondById" parameterType="Long" resultMap="RaceSecondResult">
        <include refid="selectRaceSecondVo"/>
        where t1.id = #{id}  and t1.is_deleted = 0
    </select>

    <insert id="insertRaceSecond" parameterType="com.buis.domain.RaceSecond">
        insert into race_second
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="race != null">race,</if>
            <if test="name != null">name,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="isDeleted != null">is_deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="race != null">#{race},</if>
            <if test="name != null">#{name},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
         </trim>
    </insert>

    <update id="updateRaceSecond" parameterType="com.buis.domain.RaceSecond">
        update race_second
        <trim prefix="SET" suffixOverrides=",">
            <if test="race != null">race = #{race},</if>
            <if test="name != null">name = #{name},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRaceSecondById" parameterType="Long">
        update race_second
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteRaceSecondByIds" parameterType="String">
        update race_second
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>