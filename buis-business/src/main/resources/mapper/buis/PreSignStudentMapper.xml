<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.PreSignStudentMapper">
    
    <resultMap type="com.buis.vo.PreSignStudentVo" id="PreSignStudentResult">
        <result property="id"    column="id"    />
        <result property="student"    column="student"    />
        <result property="race"    column="race"    />
        <result property="raceName"    column="race_name"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectPreSignStudentVo">
        select t1.id, t1.student, t1.race,t2.name as race_name, t1.is_deleted, t1.create_time, t1.update_time
        from pre_sign_student t1
                 left join race_info t2 on t1.race = t2.id
    </sql>

    <select id="selectPreSignStudentList" parameterType="com.buis.domain.PreSignStudent" resultMap="PreSignStudentResult">
        <include refid="selectPreSignStudentVo"/>
        <where>
            t1.is_deleted = 0
            <if test="id != null "> and t1.id = #{id}</if>
            <if test="student != null "> and t1.student = #{student}</if>
            <if test="race != null "> and t1.race = #{race}</if>
            <if test="updateTime != null "> and t1.update_time = #{updateTime}</if>
        </where>
    </select>
    
    <select id="selectPreSignStudentById" parameterType="Long" resultMap="PreSignStudentResult">
        <include refid="selectPreSignStudentVo"/>
        where t1.id = #{id}  and t1.is_deleted = 0
    </select>

    <insert id="insertPreSignStudent" parameterType="com.buis.domain.PreSignStudent" useGeneratedKeys="true" keyProperty="id">
        insert into pre_sign_student
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="student != null">student,</if>
            <if test="race != null">race,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="student != null">#{student},</if>
            <if test="race != null">#{race},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updatePreSignStudent" parameterType="com.buis.domain.PreSignStudent">
        update pre_sign_student
        <trim prefix="SET" suffixOverrides=",">
            <if test="student != null">student = #{student},</if>
            <if test="race != null">race = #{race},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePreSignStudentById" parameterType="Long">
        update pre_sign_student
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deletePreSignStudentByIds" parameterType="String">
        update pre_sign_student
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deletePreSignStudentByRaceIdAndUserId">
        update pre_sign_student
        set is_deleted = 1
        where student = #{userId} and race = #{race}
    </delete>
</mapper>