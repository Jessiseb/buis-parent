<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.TeamMemberStudentMapper">
    
    <resultMap type="TeamMemberStudent" id="TeamMemberStudentResult">
        <result property="id"    column="id"    />
        <result property="race"    column="race"    />
        <result property="team"    column="team"    />
        <result property="student"    column="student"    />
        <result property="decider"    column="decider"    />
        <result property="isChoosed"    column="is_choosed"    />
        <result property="reason"    column="reason"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTeamMemberStudentVo">
        select id, race, team, student, decider, is_choosed, reason, is_deleted, create_time, update_time from team_member_student
    </sql>

    <select id="selectTeamMemberStudentList" parameterType="TeamMemberStudent" resultMap="TeamMemberStudentResult">
        <include refid="selectTeamMemberStudentVo"/>
        <where>
            is_deleted = 0
            <if test="id != null "> and id = #{id}</if>
            <if test="race != null "> and race = #{race}</if>
            <if test="team != null "> and team = #{team}</if>
            <if test="student != null "> and student = #{student}</if>
            <if test="decider != null "> and decider = #{decider}</if>
            <if test="isChoosed != null "> and is_choosed = #{isChoosed}</if>
            <if test="reason != null  and reason != ''"> and reason like concat('%', #{reason}, '%')</if>
        </where>
    </select>
    
    <select id="selectTeamMemberStudentById" parameterType="Long" resultMap="TeamMemberStudentResult">
        <include refid="selectTeamMemberStudentVo"/>
        where id = #{id}  and is_deleted = 0
    </select>
    <select id="getCount" resultType="java.lang.Integer">
        SELECT COUNT(team_member_student.student) as teamNumbers
        FROM team_info
                 LEFT JOIN team_member_student ON team_info.id = team_member_student.team
        WHERE team_info.id = #{id} AND team_member_student.is_deleted = 0
    </select>
    <select id="getCountAndStudents" resultType="java.util.Map">
        SELECT
            COUNT(team_member_student.student) AS teamNumbers,
            (SELECT GROUP_CONCAT(CONCAT(user_info.id, ':', user_info.`name`))
             FROM user_info
                      INNER JOIN team_member_student ON user_info.id = team_member_student.student
             WHERE team_member_student.team = team_info.id AND team_member_student.is_deleted = 0) AS teamMembersNameWithIds
        FROM
            team_info
                LEFT JOIN
            team_member_student ON team_info.id = team_member_student.team AND team_member_student.is_deleted = 0
        WHERE
            team_info.id = #{id}
    </select>
    <!-- <select id="getCountAndStudents" resultType="java.util.Map">
         SELECT
             COUNT(team_member_teacher.teacher) AS teamNumbers,
             (SELECT GROUP_CONCAT(user_info.`name`)
              FROM user_info
                       INNER JOIN team_member_student ON user_info.id = team_member_student.student
              WHERE team_member_student.team = team_info.id AND team_member_student.is_deleted = 0) AS teamMembersName
         FROM
             team_info
                 LEFT JOIN
             team_member_student ON team_info.id = team_member_student.team
         WHERE
             team_info.id = #{id} AND team_member_student.is_deleted = 0
     </select>-->


    <insert id="insertTeamMemberStudent" parameterType="TeamMemberStudent" useGeneratedKeys="true" keyProperty="id">
        insert into team_member_student
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="race != null">race,</if>
            <if test="team != null">team,</if>
            <if test="student != null">student,</if>
            <if test="decider != null">decider,</if>
            <if test="isChoosed != null">is_choosed,</if>
            <if test="reason != null and reason != ''">reason,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="race != null">#{race},</if>
            <if test="team != null">#{team},</if>
            <if test="student != null">#{student},</if>
            <if test="decider != null">#{decider},</if>
            <if test="isChoosed != null">#{isChoosed},</if>
            <if test="reason != null and reason != ''">#{reason},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTeamMemberStudent" parameterType="TeamMemberStudent">
        update team_member_student
        <trim prefix="SET" suffixOverrides=",">
            <if test="race != null">race = #{race},</if>
            <if test="team != null">team = #{team},</if>
            <if test="student != null">student = #{student},</if>
            <if test="decider != null">decider = #{decider},</if>
            <if test="isChoosed != null">is_choosed = #{isChoosed},</if>
            <if test="reason != null and reason != ''">reason = #{reason},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTeamMemberStudentById" parameterType="Long">
        update team_member_student
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteTeamMemberStudentByIds" parameterType="String">
        update team_member_student
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>