<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.TeamMemberStudentMapper">

    <resultMap type="com.buis.vo.TeamMemberStudentVo" id="TeamMemberStudentResult">
        <result property="id" column="id"/>
        <result property="race" column="race"/>
        <result property="raceName" column="race_name"/>
        <result property="team" column="team"/>
        <result property="teamName" column="team_name"/>
        <result property="student" column="student"/>
        <result property="decider" column="decider"/>
        <result property="isChoosed" column="is_choosed"/>
        <result property="reason" column="reason"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectTeamMemberStudentVo">
        select t1.id,
               t1.race,
               t1.team,
               t1.student,
               t2.name as team_name,
               t3.name as race_name,
               t1.decider,
               t1.is_choosed,
               t1.reason,
               t1.is_deleted,
               t1.create_time,
               t1.update_time
        from team_member_student t1
                 left join team_info t2 on t1.team = t2.id
                 left join race_info t3 on t1.race = t3.id
    </sql>

    <select id="selectTeamMemberStudentList" resultMap="TeamMemberStudentResult">
        <include refid="selectTeamMemberStudentVo"/>
        <where>
            t1.is_deleted = 0
            <if test="id != null ">and t1.id = #{id}</if>
            <if test="race != null ">and t1.race = #{race}</if>
            <if test="team != null ">and t1.team = #{team}</if>
            <if test="student != null ">and t1.student = #{student}</if>
            <if test="decider != null ">and t1.decider = #{decider}</if>
            <if test="isChoosed != null ">and t1.is_choosed = #{isChoosed}</if>
            <if test="reason != null  and reason != ''">and t1.reason like concat('%', #{reason}, '%')</if>
        </where>
    </select>

    <select id="selectTeamMemberStudentById" parameterType="Long" resultMap="TeamMemberStudentResult">
        <include refid="selectTeamMemberStudentVo"/>
        where t1.id = #{id} and t1.is_deleted = 0
    </select>


    <select id="getMemberStudentByTeamId" resultType="java.lang.Long">
        SELECT t2.id
        FROM team_member_student t1
                 LEFT JOIN user_info t2 ON t1.student = t2.id
        WHERE t1.is_deleted = 0
          AND t1.is_choosed = 1
          AND t1.team = #{team}
    </select>


    <select id="getJoinCountByTeamId" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM team_member_student
        WHERE team = #{id}
          AND is_deleted = 0
          and is_choosed = 1
    </select>

    <select id="getCountJoin" resultType="java.lang.Integer">
        select count(1)
        from team_member_student
        <where>
            is_deleted = 0 and is_choosed = 1
            <if test="raceId != null">and race = #{raceId}</if>
            <if test="team   != null">and team = #{team}</if>
            <if test="userId != null">and student = #{userId}</if>
        </where>
    </select>


    <select id="getJoinTeamByUserId" resultType="java.lang.Integer">
        select count(1)

        from team_member_student

        <where>
            is_deleted = 0 and is_choosed = 1
            <if test="userId != null">and student = #{userId}</if>
        </where>
    </select>
    <select id="selectTeamMemberStudentByTeamId" resultType="com.buis.domain.TeamMemberStudent">
        select *
        from team_member_student
        where team = #{team}
          and is_deleted = 0
          and is_choosed = 1
    </select>
    <select id="selectTeamMemberStudentByTeamAndStudent" resultType="com.buis.domain.TeamMemberStudent">
        select *
        from team_member_student

        <where>
            is_deleted = 0
            <if test="team   != null and team != ''">and team = #{team}</if>
            <if test="user != null and user != ''">and student = #{user}</if>
        </where>
    </select>
    <select id="getRequestCount" resultType="java.lang.Integer">
        select count(1)

        from team_member_student

        <where>
            is_deleted = 0
            <if test="raceId != null">and race = #{raceId}</if>
            <if test="team   != null">and team = #{team}</if>
            <if test="userId != null">and student = #{userId}</if>
        </where>
    </select>
    <select id="selectTeamMemberStudentByUserId" resultType="com.buis.domain.TeamMemberStudent">
        select *
        from team_member_student
        where student = #{userId}
          and is_deleted = 0
          and is_choosed = 1
    </select>
    <select id="selectTeamMemberStudentListVo" resultType="com.buis.vo.TeamMemberStudentVo">
            <include refid="selectTeamMemberStudentVo"/>
        left join user_info t4 on t1.student = t4.id
            <where>
                t1.is_deleted = 0
                <if test="id != null ">and t1.id = #{id}</if>
                <if test="race != null ">and t1.race = #{race}</if>
                <if test="team != null ">and t1.team = #{team}</if>
                <if test="student != null ">and t1.student = #{student}</if>
                <if test="decider != null ">and t1.decider = #{decider}</if>
                <if test="isChoosed != null ">and t1.is_choosed = #{isChoosed}</if>
                <if test="reason != null  and reason != ''">and t1.reason like concat('%', #{reason}, '%')</if>
                <if test="studentName != null  and studentName != ''">
                    and t4.name like concat('%', #{studentName}, '%')
                </if>
            </where>

    </select>


    <insert id="insertTeamMemberStudent" parameterType="com.buis.domain.TeamMemberStudent" useGeneratedKeys="true"
            keyProperty="id">
        insert into team_member_student
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="race != null">race,</if>
            <if test="team != null">team,</if>
            <if test="student != null">student,</if>
            <if test="decider != null">decider,</if>
            <if test="isChoosed != null">is_choosed,</if>
            <if test="reason != null and reason != ''">reason,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="race != null">#{race},</if>
            <if test="team != null">#{team},</if>
            <if test="student != null">#{student},</if>
            <if test="decider != null">#{decider},</if>
            <if test="isChoosed != null">#{isChoosed},</if>
            <if test="reason != null and reason != ''">#{reason},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>
    <insert id="insertTeamMemberStudentByList">
        <foreach collection="teamMemberStudentList" item="item" separator=";">
            insert into team_member_student
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="item.race != null and item.race != ''">race,</if>
                <if test="item.team != null and item.team != ''">team,</if>
                <if test="item.student != null and item.student != ''">student,</if>
                <if test="item.decider != null and item.decider != ''">decider,</if>
                <if test="item.isChoosed != null and item.isChoosed != ''">is_choosed,</if>
                <if test="item.reason != null and item.reason != ''">reason,</if>
                <if test="item.isDeleted != null and item.isDeleted != ''">is_deleted,</if>
                <if test="item.createTime != null and item.createTime != ''">create_time,</if>
                <if test="item.updateTime != null and item.updateTime != ''">update_time,</if>
            </trim>
            <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="item.race != null and item.race != ''">#{item.race},</if>
                <if test="item.team != null and item.team != ''">#{item.team},</if>
                <if test="item.student != null and item.student != ''">#{item.student},</if>
                <if test="item.decider != null and item.decider != ''">#{item.decider},</if>
                <if test="item.isChoosed != null and item.isChoosed != ''">#{item.isChoosed},</if>
                <if test="item.reason != null and item.reason != ''">#{item.reason},</if>
                <if test="item.isDeleted != null and item.isDeleted != ''">#{item.isDeleted},</if>
                <if test="item.createTime != null and item.createTime != ''">#{item.createTime},</if>
                <if test="item.updateTime != null and item.updateTime != ''">#{item.updateTime},</if>
            </trim>
        </foreach>
    </insert>

    <update id="updateTeamMemberStudent" parameterType="com.buis.domain.TeamMemberStudent">
        update team_member_student
        <trim prefix="SET" suffixOverrides=",">
            <if test="race != null">race = #{race},</if>
            <if test="team != null">team = #{team},</if>
            <if test="student != null">student = #{student},</if>
            <if test="decider != null">decider = #{decider},</if>
            <if test="isChoosed != null">is_choosed = #{isChoosed},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>
    <update id="quitTeam">
        update team_member_student
        set is_deleted = 1
        where team = #{team}
          and student = #{user}
    </update>


    <delete id="deleteTeamMemberStudentById" parameterType="Long">
        update team_member_student
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteTeamMemberStudentByIds" parameterType="String">
        update team_member_student
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <delete id="deleteTeamMemberStudentByTeamAndStudent">
        update team_member_student
        set is_deleted = 1
        where team = #{team}
          and student = #{user}
    </delete>
    <delete id="deleteTeamMemberStudentByTeam">
        update team_member_student
        set is_deleted = 1
        where team = #{team}
    </delete>
</mapper>