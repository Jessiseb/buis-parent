<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.ScoreMapper">
    
    <resultMap type="com.buis.model.vo.ScoreVo" id="ScoreResult">
        <result property="id"    column="id"    />
        <result property="race"    column="race"    />
        <result property="raceName"    column="race_name"    />
        <result property="judgeName"    column="judge_name"    />
        <result property="projectName"    column="project_name"    />
        <result property="teacher"    column="teacher"    />
        <result property="team"    column="team"    />
        <result property="build"    column="build"    />
        <result property="score"    column="score"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectScoreVo">
        select t1.id,
               t1.race,
               t2.name as race_name,
               t3.name as judge_name,
               t4.name as project_name,
               t1.teacher,
               t1.team,
               t1.build,
               t1.score,
               t1.is_deleted,
               t1.create_time,
               t1.update_time
        from t_score t1
                 left join race_info t2 on t1.race = t2.id
                 left join user_info t3 on t1.teacher = t3.id
                 left join team_info t4 on t1.team = t4.id
    </sql>

    <select id="selectScoreList" parameterType="com.buis.model.vo.ScoreVo" resultMap="ScoreResult">
        <include refid="selectScoreVo"/>
        <where>
            t1.is_deleted = 0
            <if test="id != null "> and t1.id = #{id}</if>
            <if test="race != null "> and t1.race = #{race}</if>
            <if test="teacher != null "> and t1.teacher = #{teacher}</if>
            <if test="team != null "> and t1.team = #{team}</if>
            <if test="params.beginScore != null and params.beginScore != '' and params.endScore != null and params.endScore != ''"> and t1.score between #{params.beginScore} and #{params.endScore}</if>
        </where>
    </select>
    
    <select id="selectScoreById" parameterType="Long" resultMap="ScoreResult">
        <include refid="selectScoreVo"/>
        where t1.id = #{id}  and t1.is_deleted = 0
    </select>

    <select id="selectTeamsRanking" resultType="com.buis.model.domain.Score">
        SELECT s.score,s.team
        FROM t_score AS s
        ORDER BY s.score DESC
    </select>
    <select id="selectScoreListFuzzyQuery" resultType="com.buis.model.vo.ScoreVo">
        <include refid="selectScoreVo"/>
        <where>
            t1.is_deleted = 0
            <if test="id != null "> and t1.id = #{id}</if>
            <if test="race != null "> and t1.race = #{race}</if>
            <if test="teacher != null "> and t1.teacher = #{teacher}</if>
            <if test="team != null "> and t1.team = #{team}</if>
            <if test="judgeName != null and judgeName != ''">
                and t3.name LIKE CONCAT('%', #{judgeName}, '%')
            </if>
            <if test="projectName != null and projectName != ''">
            and t4.name LIKE CONCAT('%', #{projectName}, '%')
            </if>
        </where>
    </select>

    <insert id="insertScore" parameterType="com.buis.model.domain.Score" useGeneratedKeys="true" keyProperty="id">
        insert into t_score
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="race != null">race,</if>
            <if test="teacher != null">teacher,</if>
            <if test="team != null">team,</if>
            <if test="build != null">build,</if>
            <if test="score != null">score,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="race != null">#{race},</if>
            <if test="teacher != null">#{teacher},</if>
            <if test="team != null">#{team},</if>
            <if test="build != null">#{build},</if>
            <if test="score != null">#{score},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateScore" parameterType="com.buis.model.domain.Score">
        update t_score
        <trim prefix="SET" suffixOverrides=",">
            <if test="race != null">race = #{race},</if>
            <if test="teacher != null">teacher = #{teacher},</if>
            <if test="team != null">team = #{team},</if>
            <if test="build != null">build = #{build},</if>
            <if test="score != null">score = #{score},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteScoreById" parameterType="Long">
        update t_score
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteScoreByIds" parameterType="String">
        update t_score
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="getStudentAbilityDistribution" parameterType="map" resultType="com.buis.model.vo.StudentAbilityDistributionVo">
        SELECT
            CASE
                WHEN s.score >= 60 AND s.score &lt; 70 THEN '60-70'
                WHEN s.score >= 70 AND s.score &lt; 80 THEN '70-80'
                WHEN s.score >= 80 AND s.score &lt; 90 THEN '80-90'
                WHEN s.score >= 90 AND s.score &lt;= 100 THEN '90-100'
                ELSE '其他'
            END AS scoreRange,
            COUNT(DISTINCT u.id) AS studentCount
        FROM t_score s
        JOIN team_info t ON s.team = t.id
        JOIN team_member_student tms ON t.id = tms.team
        JOIN user_info u ON tms.student = u.id
        LEFT JOIN race_info r ON s.race = r.id
        WHERE
            (t.teacher1 = #{teacherId} OR t.teacher2 = #{teacherId})
            AND s.is_deleted = 0
            AND t.is_deleted = 0
            AND tms.is_deleted = 0
            AND u.is_deleted = 0
            <if test="sClass != null and sClass != ''">
                AND u.s_class = #{sClass}
            </if>
            <if test="projectType != null and projectType != 0">
                AND r.race_type = #{projectType}
            </if>
            <if test="year != null and year != ''">
                AND r.year = #{year}
            </if>
        GROUP BY scoreRange
        ORDER BY scoreRange
    </select>
</mapper>