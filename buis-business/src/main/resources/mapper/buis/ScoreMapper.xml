<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.ScoreMapper">
    
    <resultMap type="com.buis.domain.Score" id="ScoreResult">
        <result property="id"    column="id"    />
        <result property="race"    column="race"    />
        <result property="teacher"    column="teacher"    />
        <result property="team"    column="team"    />
        <result property="build"    column="build"    />
        <result property="score"    column="score"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectScoreVo">
        select id, race, teacher, team, build, score, is_deleted, create_time, update_time from t_score
    </sql>

    <select id="selectScoreList" parameterType="com.buis.domain.Score" resultMap="ScoreResult">
        <include refid="selectScoreVo"/>
        <where>
            is_deleted = 0
            <if test="id != null "> and id = #{id}</if>
            <if test="race != null "> and race = #{race}</if>
            <if test="teacher != null "> and teacher = #{teacher}</if>
            <if test="team != null "> and team = #{team}</if>
            <if test="params.beginScore != null and params.beginScore != '' and params.endScore != null and params.endScore != ''"> and score between #{params.beginScore} and #{params.endScore}</if>
        </where>
    </select>
    
    <select id="selectScoreById" parameterType="Long" resultMap="ScoreResult">
        <include refid="selectScoreVo"/>
        where id = #{id}  and is_deleted = 0
    </select>

    <insert id="insertScore" parameterType="com.buis.domain.Score" useGeneratedKeys="true" keyProperty="id">
        insert into t_score
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="race != null">race,</if>
            <if test="teacher != null">teacher,</if>
            <if test="team != null">team,</if>
            <if test="build != null">build,</if>
            <if test="score != null">score,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="race != null">#{race},</if>
            <if test="teacher != null">#{teacher},</if>
            <if test="team != null">#{team},</if>
            <if test="build != null">#{build},</if>
            <if test="score != null">#{score},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateScore" parameterType="com.buis.domain.Score">
        update t_score
        <trim prefix="SET" suffixOverrides=",">
            <if test="race != null">race = #{race},</if>
            <if test="teacher != null">teacher = #{teacher},</if>
            <if test="team != null">team = #{team},</if>
            <if test="build != null">build = #{build},</if>
            <if test="score != null">score = #{score},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteScoreById" parameterType="Long">
        update t_score
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteScoreByIds" parameterType="String">
        update t_score
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>