    <sql id="selectRaceLanqiaoTeacherVo">
        select t2.name as college_name, t3.name as major_name,t1.id, t1.race_id, t1.user_id, t1.name, t1.sex, t1.number,t1.college, t1.major, t1.title, t1.office, t1.phone, t1.email, t1.identity, t1.course, t1.type, t1.t_class, t1.bank_number, t1.guidance, t1.remark, t1.is_deleted, t1.create_time, t1.update_time
        from race_lanqiao_teacher t1
         left join t_college_major t2 on t1.college = t2.id
         left join t_college_major t3 on t1.major = t3.id
    </sql>

