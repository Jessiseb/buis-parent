<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.PreSignTeacherMapper">
    
    <resultMap type="com.buis.vo.PreSignTeacherVo" id="PreSignTeacherResult">
        <result property="id"    column="id"    />
        <result property="teacher"    column="teacher"    />
        <result property="race"    column="race"    />
        <result property="raceName"    column="race_name"    />
        <result property="fileUrl"    column="file_url"    />
        <result property="status"    column="status"    />
        <result property="reason"    column="reason"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectPreSignTeacherVo">
        select id, teacher, race,t2.name as race_name, file_url, status, reason, is_deleted, create_time, update_time
        from pre_sign_teacher t1
                 left join race_info t2 on t1.race = t2.id
    </sql>

    <select id="selectPreSignTeacherList" parameterType="com.buis.domain.PreSignTeacher" resultMap="PreSignTeacherResult">
        <include refid="selectPreSignTeacherVo"/>
        <where>
            is_deleted = 0
            <if test="id != null "> and id = #{id}</if>
            <if test="teacher != null "> and teacher = #{teacher}</if>
            <if test="race != null "> and race = #{race}</if>
            <if test="fileUrl != null  and fileUrl != ''"> and file_url like concat('%', #{fileUrl}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="reason != null  and reason != ''"> and reason like concat('%', #{reason}, '%')</if>
        </where>
    </select>
    
    <select id="selectPreSignTeacherById" parameterType="Long" resultMap="PreSignTeacherResult">
        <include refid="selectPreSignTeacherVo"/>
        where id = #{id}  and is_deleted = 0
    </select>


    <insert id="insertPreSignTeacher" parameterType="com.buis.domain.PreSignTeacher" useGeneratedKeys="true" keyProperty="id">
        insert into pre_sign_teacher
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teacher != null">teacher,</if>
            <if test="race != null">race,</if>
            <if test="fileUrl != null">file_url,</if>
            <if test="status != null">status,</if>
            <if test="reason != null">reason,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teacher != null">#{teacher},</if>
            <if test="race != null">#{race},</if>
            <if test="fileUrl != null">#{fileUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="reason != null">#{reason},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>


    <update id="updatePreSignTeacher" parameterType="com.buis.domain.PreSignTeacher">
        update pre_sign_teacher
        <trim prefix="SET" suffixOverrides=",">
            <if test="teacher != null">teacher = #{teacher},</if>
            <if test="race != null">race = #{race},</if>
            <if test="fileUrl != null">file_url = #{fileUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePreSignTeacherById" parameterType="Long">
        update pre_sign_teacher
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deletePreSignTeacherByIds" parameterType="String">
        update pre_sign_teacher
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>