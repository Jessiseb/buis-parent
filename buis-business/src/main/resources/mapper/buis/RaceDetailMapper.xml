    <sql id="selectRaceDetailVo">
        select t2.name as race_name,
               t1.id,
               t1.parent_id,
               t1.race,
               t1.name,
               t1.review_status,
               t3.name as race_type,
               t1.count,
               t1.phone,
               t1.email,
               t1.desc_url,
               t1.group_url,
               t1.rule,
               t1.capacity,
               t1.team_min,
               t1.team_max,
               t1.teacher_min,
               t1.teacher_max,
               t1.r_rank,
               t1.t_limit,
               t1.is_deleted,
               t1.create_time,
               t1.update_time,
               t2.son_tid
        from race_detail t1
                 left join race_info t2 ON t1.race = t2.id
                 left join race_type t3 on t2.son_tid = t3.id
    </sql>

    <select id="selectRaceDetailList" parameterType="com.buis.vo.RaceDetailVo" resultMap="RaceDetailResult">
        <include refid="selectRaceDetailVo"/>
        <where>
            t1.is_deleted = 0
            <if test="raceDetail.id != null and raceDetail.id != '' ">and t1.id = #{raceDetail.id}</if>
            <if test="raceDetail.parentId != null and raceDetail.parentId != '' ">and t1.parent_id =
                #{raceDetail.parentId}
            </if>
            <if test="raceDetail.race != null and raceDetail.race != ''">and t1.race = #{raceDetail.race}</if>
            <if test="raceDetail.name != null  and raceDetail.name != ''">and t1.name like concat('%',
                #{raceDetail.name}, '%')
            </if>
            <if test="raceDetail.reviewStatus != null and raceDetail.reviewStatus != ''">and t1.review_status =
                #{raceDetail.reviewStatus}
            </if>
            <if test="raceDetail.count != null and raceDetail.count != ''">and t1.count = #{raceDetail.count}</if>
            <if test="raceDetail.teamMin != null and raceDetail.teamMin != ''">and t1.team_min = #{raceDetail.teamMin}
            </if>
            <if test="raceDetail.teamMax != null and raceDetail.teamMax != ''">and t1.team_max = #{raceDetail.teamMax}
            </if>
            <if test="raceDetail.teacherMin != null and raceDetail.teacherMin != ''">and t1.teacher_min =
                #{raceDetail.teacherMin}
            </if>
            <if test="raceDetail.teacherMax != null and raceDetail.teacherMax != ''">and t1.teacher_max =
                #{raceDetail.teacherMax}
            </if>
            <if test="raceDetail.phone != null  and raceDetail.phone != ''">and t1.phone = #{raceDetail.phone}</if>
            <if test="raceDetail.email != null  and raceDetail.email != ''">and t1.email = #{raceDetail.email}</if>
            <if test="raceDetail.capacity != null and raceDetail.capacity != ''">and t1.capacity =
                #{raceDetail.capacity}
            </if>
            <if test="raceDetail.rRank != null and raceDetail.rRank != ''">and t1.r_rank = #{raceDetail.rRank}</if>
            <if test="raceDetail.tLimit != null and raceDetail.tLimit != ''">and t1.t_limit = #{raceDetail.tLimit}</if>
        </where>
    </select>

    <select id="selectRaceDetailById" parameterType="Long" resultMap="RaceDetailWeightResult">
        select id,
               parent_id,
               race,
               count,
               name,
               review_status,
               phone,
               email,
               desc_url,
               group_url,
               rule,
               capacity,
               team_min,
               team_max,
               teacher_min,
               teacher_max,
               r_rank,
               t_limit,
               is_deleted,
               create_time,
               update_time
        from race_detail
        where id = #{id}
          and is_deleted = 0
    </select>

    <select id="selectWeightList" resultMap="WeightResult">
        select id, race_d, name, weight, is_deleted, create_time, update_time
        from t_weight
        where race_d = #{race_d} and is_deleted = 0
    </select>
    <select id="selectRaceDetailByRaceId" resultType="com.buis.domain.RaceDetail">
        select id,
               parent_id,
               race,
               count,
               name,
               review_status,
               phone,
               email,
               desc_url,
               group_url,
               rule,
               capacity,
               team_min,
               team_max,
               teacher_min,
               teacher_max,
               r_rank,
               t_limit,
               is_deleted,
               create_time,
               update_time
        from race_detail
        where race = #{raceId}
