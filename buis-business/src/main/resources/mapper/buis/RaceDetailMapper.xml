<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.RaceDetailMapper">

    <resultMap type="com.buis.vo.RaceDetailVo" id="RaceDetailResult">
        <result property="id" column="id"/>
        <result property="raceName" column="race_name"/>
        <result property="race" column="race"/>
        <result property="name" column="name"/>
        <result property="count" column="count"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="descUrl" column="desc_url"/>
        <result property="groupUrl" column="group_url"/>
        <result property="rule" column="rule"/>
        <result property="capacity" column="capacity"/>
        <result property="teamMin" column="team_min"/>
        <result property="teamMax" column="team_max"/>
        <result property="teacherMin" column="teacher_min"/>
        <result property="teacherMax" column="teacher_max"/>
        <result property="rRank" column="r_rank"/>
        <result property="tLimit" column="t_limit"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>

    </resultMap>

    <resultMap id="RaceDetailWeightResult" type="com.buis.vo.RaceDetailVo" extends="RaceDetailResult">
        <collection property="weightList" ofType="com.buis.domain.Weight" column="id" select="selectWeightList"/>
    </resultMap>

    <resultMap type="com.buis.domain.Weight" id="WeightResult">
        <result property="id" column="id"/>
        <result property="raceD" column="race_d"/>
        <result property="name" column="name"/>
        <result property="weight" column="weight"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectRaceDetailVo">
        select t2.name as race_name,
               t1.id,
               t1.race,
               t1.name,
               t1.count,
               t1.phone,
               t1.email,
               t1.desc_url,
               t1.group_url,
               t1.rule,
               t1.capacity,
               t1.team_min,
               t1.team_max,
               t1.teacher_min,
               t1.teacher_max,
               t1.r_rank,
               t1.t_limit,
               t1.is_deleted,
               t1.create_time,
               t1.update_time
        from race_detail t1
                 left join race_info t2 ON t1.race = t2.id
    </sql>

    <select id="selectRaceDetailList" parameterType="com.buis.vo.RaceDetailVo" resultMap="RaceDetailResult">
        <include refid="selectRaceDetailVo"/>
        <where>
            t1.is_deleted = 0
            <if test="raceDetail.id != null and raceDetail.id != '' ">and t1.id = #{raceDetail.id}</if>
            <if test="raceDetail.race != null and raceDetail.race != ''">and t1.race = #{raceDetail.race}</if>
            <if test="raceDetail.name != null  and raceDetail.name != ''">and t1.name like concat('%', #{raceDetail.name}, '%')
            </if>
            <if test="raceDetail.count != null and raceDetail.count != ''">and t1.count = #{raceDetail.count}</if>
            <if test="raceDetail.teamMin != null and raceDetail.teamMin != ''">and t1.team_min = #{raceDetail.teamMin}</if>
            <if test="raceDetail.teamMax != null and raceDetail.teamMax != ''">and t1.team_max = #{raceDetail.teamMax}</if>
            <if test="raceDetail.teacherMin != null and raceDetail.teacherMin != ''">and t1.teacher_min = #{raceDetail.teacherMin}</if>
            <if test="raceDetail.teacherMax != null and raceDetail.teacherMax != ''">and t1.teacher_max = #{raceDetail.teacherMax}</if>
            <if test="raceDetail.phone != null  and raceDetail.phone != ''">and t1.phone = #{raceDetail.phone}</if>
            <if test="raceDetail.email != null  and raceDetail.email != ''">and t1.email = #{raceDetail.email}</if>
            <if test="raceDetail.capacity != null and raceDetail.capacity != ''">and t1.capacity = #{raceDetail.capacity}</if>
            <if test="raceDetail.rRank != null and raceDetail.rRank != ''">and t1.r_rank = #{raceDetail.rRank}</if>
            <if test="raceDetail.tLimit != null and raceDetail.tLimit != ''">and t1.t_limit = #{raceDetail.tLimit}</if>
        </where>
    </select>

    <select id="selectRaceDetailById" parameterType="Long" resultMap="RaceDetailWeightResult">
        select id, race,count, name, phone, email, desc_url, group_url, rule, capacity, team_min, team_max, teacher_min, teacher_max, r_rank, t_limit, is_deleted, create_time, update_time
        from race_detail
        where id = #{id} and is_deleted = 0
    </select>

    <select id="selectWeightList" resultMap="WeightResult">
        select id, race_d, name, weight, is_deleted, create_time, update_time
        from t_weight
        where race_d = #{race_d} and is_deleted = 0
    </select>
    <select id="selectRaceDetailByRaceId" resultType="com.buis.domain.RaceDetail">
-- 查询比赛信息
        select id, race,count, name, phone, email, desc_url, group_url, rule, capacity, team_min, team_max, teacher_min, teacher_max, r_rank, t_limit, is_deleted, create_time, update_time
        from race_detail
        where race = #{raceId} and is_deleted = 0
    </select>
    <select id="batchSelectRaceDetailByRaceIds" resultType="com.buis.domain.RaceDetail">
        select id, race, name, phone, email, desc_url, group_url, rule, capacity, team_min, team_max, teacher_min, teacher_max, r_rank, t_limit, is_deleted, create_time, update_time
        from race_detail
        where race in
        <foreach collection="raceIds" item="raceId" open="(" separator="," close=")">
            #{raceId}
        </foreach>
        and is_deleted = 0
    </select>

    <select id="selectRaceDetailVoList" resultType="com.buis.vo.RaceDetailVo">
        <include refid="selectRaceDetailVo"/>
        <where>
            t1.is_deleted = 0
            <if test="raceDetailVo.id != null and raceDetailVo.id != '' ">and t1.id = #{raceDetailVo.id}</if>
            <if test="raceDetailVo.race != null and raceDetailVo.race != ''">and t1.race = #{raceDetailVo.race}</if>
            <if test="raceDetailVo.name != null  and raceDetailVo.name != ''">and t1.name like concat('%', #{raceDetailVo.name}, '%')
            </if>
            <if test="raceDetailVo.raceName != null and raceDetailVo.raceName != ''">and t2.name like concat('%', #{raceDetailVo.raceName}, '%')</if>
            <if test="raceDetailVo.count != null and raceDetailVo.count != ''">and t1.count = #{raceDetailVo.count}</if>
            <if test="raceDetailVo.teamMin != null and raceDetailVo.teamMin != ''">and t1.team_min = #{raceDetailVo.teamMin}</if>
            <if test="raceDetailVo.teamMax != null and raceDetailVo.teamMax != ''">and t1.team_max = #{raceDetailVo.teamMax}</if>
            <if test="raceDetailVo.teacherMin != null and raceDetailVo.teacherMin != ''">and t1.teacher_min = #{raceDetailVo.teacherMin}</if>
            <if test="raceDetailVo.teacherMax != null and raceDetailVo.teacherMax != ''">and t1.teacher_max = #{raceDetailVo.teacherMax}</if>
            <if test="raceDetailVo.phone != null  and raceDetailVo.phone != ''">and t1.phone = #{raceDetailVo.phone}</if>
            <if test="raceDetailVo.email != null  and raceDetailVo.email != ''">and t1.email = #{raceDetailVo.email}</if>
            <if test="raceDetailVo.capacity != null and raceDetailVo.capacity != ''">and t1.capacity = #{raceDetailVo.capacity}</if>
            <if test="raceDetailVo.rRank != null and raceDetailVo.rRank != ''">and t1.r_rank = #{raceDetailVo.rRank}</if>
            <if test="raceDetailVo.tLimit != null and raceDetailVo.tLimit != ''">and t1.t_limit = #{raceDetailVo.tLimit}</if>
        </where>
    </select>

    <insert id="insertRaceDetail" parameterType="com.buis.domain.RaceDetail" useGeneratedKeys="true" keyProperty="id">
        insert into race_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="race != null">race,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="count != null">count,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="email != null and email != ''">email,</if>
            <if test="descUrl != null and descUrl != ''">desc_url,</if>
            <if test="groupUrl != null and groupUrl != ''">group_url,</if>
            <if test="rule != null">rule,</if>
            <if test="capacity != null">capacity,</if>
            <if test="teamMin != null">team_min,</if>
            <if test="teamMax != null">team_max,</if>
            <if test="teacherMin != null">teacher_min,</if>
            <if test="teacherMax != null">teacher_max,</if>
            <if test="rRank != null">r_rank,</if>
            <if test="tLimit != null">t_limit,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="race != null">#{race},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="email != null and email != ''">#{email},</if>
            <if test="descUrl != null and descUrl != ''">#{descUrl},</if>
            <if test="groupUrl != null and groupUrl != ''">#{groupUrl},</if>
            <if test="rule != null">#{rule},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="teamMin != null">#{teamMin},</if>
            <if test="teamMax != null">#{teamMax},</if>
            <if test="teacherMin != null">#{teacherMin},</if>
            <if test="teacherMax != null">#{teacherMax},</if>
            <if test="rRank != null">#{rRank},</if>
            <if test="tLimit != null">#{tLimit},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateRaceDetail" parameterType="com.buis.domain.RaceDetail">
        update race_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="race != null">race = #{race},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="email != null and email != ''">email = #{email},</if>
            <if test="descUrl != null and descUrl != ''">desc_url = #{descUrl},</if>
            <if test="groupUrl != null and groupUrl != ''">group_url = #{groupUrl},</if>
            <if test="rule != null">rule = #{rule},</if>
            <if test="count != null">count = #{count},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="teamMin != null">team_min = #{teamMin},</if>
            <if test="teamMax != null">team_max = #{teamMax},</if>
            <if test="teacherMin != null">teacher_min = #{teacherMin},</if>
            <if test="teacherMax != null">teacher_max = #{teacherMax},</if>
            <if test="rRank != null">r_rank = #{rRank},</if>
            <if test="tLimit != null">t_limit = #{tLimit},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>


    <delete id="deleteRaceDetailById" parameterType="Long">
        update race_detail
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteRaceDetailByIds" parameterType="String">
        update race_detail
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteWeightByRaceDs" parameterType="String">
        update t_weight
        set is_deleted = 1
        where race_d in
        <foreach item="raceD" collection="array" open="(" separator="," close=")">
            #{raceD}
        </foreach>
    </delete>

    <delete id="deleteWeightByRaceD" parameterType="Long">
        update t_weight
        set is_deleted = 1
        where race_d = #{raceD}
    </delete>

    <insert id="batchWeight">
        insert into t_weight( id, race_d, name, weight, is_deleted, create_time, update_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.raceD}, #{item.name}, #{item.weight}, #{item.isDeleted}, #{item.createTime}, #{item.updateTime})
        </foreach>
    </insert>


</mapper>