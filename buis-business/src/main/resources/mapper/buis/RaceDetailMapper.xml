    </select>
    <select id="batchSelectRaceDetailByRaceIds" resultType="com.buis.domain.RaceDetail">
        select id,parent_id, race, name,money,review_status, phone, email,
        desc_url, group_url, rule, capacity, team_min, team_max, teacher_min, teacher_max, r_rank, t_limit, is_deleted,
        create_time, update_time
        from race_detail
        where race in
        <foreach collection="raceIds" item="raceId" open="(" separator="," close=")">
            #{raceId}
        </foreach>
        and is_deleted = 0
    </select>

    <select id="selectRaceDetailVoList" resultType="com.buis.vo.RaceDetailVo">
        <include refid="selectRaceDetailVo"/>
        <where>
            t1.is_deleted = 0
            <if test="raceDetailVo.id != null and raceDetailVo.id != '' ">and t1.id = #{raceDetailVo.id}</if>
            <!-- 新增递归查询子分类的条件 -->
            <if test="raceDetailVo.parentId != null and raceDetailVo.parentId != ''">
                AND t1.parent_id IN (
                WITH RECURSIVE category_tree AS (
                SELECT id FROM race_type WHERE id = #{raceDetailVo.parentId}
                UNION ALL
                SELECT rt.id FROM race_type rt INNER JOIN category_tree ct ON rt.parent_id = ct.id
                )
                SELECT id FROM category_tree
                )
            </if>
            <if test="raceDetailVo.race != null and raceDetailVo.race != ''">and t1.race = #{raceDetailVo.race}</if>
            <if test="raceDetailVo.name != null  and raceDetailVo.name != ''">and t1.name like concat('%',
                #{raceDetailVo.name}, '%')
            </if>
            <if test="raceDetailVo.raceName != null and raceDetailVo.raceName != ''">and t2.name like concat('%',
                #{raceDetailVo.raceName}, '%')
            </if>
            <if test="raceDetailVo.raceType != null  and raceDetailVo.raceType != ''">and t3.name =
                #{raceDetailVo.raceType}
            </if>
            <if test="raceDetailVo.reviewStatus != null and raceDetailVo.reviewStatus != ''">and t1.review_status =
                #{raceDetailVo.reviewStatus}
            </if>
            <if test="raceDetailVo.count != null and raceDetailVo.count != ''">and t1.count = #{raceDetailVo.count}</if>
            <if test="raceDetailVo.teamMin != null and raceDetailVo.teamMin != ''">and t1.team_min =
                #{raceDetailVo.teamMin}
            </if>
            <if test="raceDetailVo.teamMax != null and raceDetailVo.teamMax != ''">and t1.team_max =
                #{raceDetailVo.teamMax}
            </if>
            <if test="raceDetailVo.teacherMin != null and raceDetailVo.teacherMin != ''">and t1.teacher_min =
                #{raceDetailVo.teacherMin}
            </if>
            <if test="raceDetailVo.teacherMax != null and raceDetailVo.teacherMax != ''">and t1.teacher_max =
                #{raceDetailVo.teacherMax}
            </if>
            <if test="raceDetailVo.phone != null  and raceDetailVo.phone != ''">and t1.phone = #{raceDetailVo.phone}
            </if>
            <if test="raceDetailVo.email != null  and raceDetailVo.email != ''">and t1.email = #{raceDetailVo.email}
            </if>
            <if test="raceDetailVo.capacity != null and raceDetailVo.capacity != ''">and t1.capacity =
                #{raceDetailVo.capacity}
            </if>
            <if test="raceDetailVo.rRank != null and raceDetailVo.rRank != ''">and t1.r_rank = #{raceDetailVo.rRank}
            </if>
            <if test="raceDetailVo.tLimit != null and raceDetailVo.tLimit != ''">and t1.t_limit =
                #{raceDetailVo.tLimit}
            </if>
        </where>
    </select>

