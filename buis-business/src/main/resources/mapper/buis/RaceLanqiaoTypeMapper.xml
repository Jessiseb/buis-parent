<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.RaceLanqiaoTypeMapper">
    
    <resultMap type="com.buis.model.domain.RaceLanqiaoType" id="RaceLanqiaoTypeResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="sort"    column="sort"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectRaceLanqiaoTypeVo">
        select id, name, parent_id, sort, is_deleted, create_time, update_time from race_lanqiao_type
    </sql>

    <select id="selectRaceLanqiaoTypeList" parameterType="com.buis.model.domain.RaceLanqiaoType" resultMap="RaceLanqiaoTypeResult">
        <include refid="selectRaceLanqiaoTypeVo"/>
        <where>
            is_deleted = 0
            <if test="id != null "> and id = #{id}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="sort != null "> and sort = #{sort}</if>
        </where>
        order by sort asc
    </select>
    
    <select id="selectRaceLanqiaoTypeById" parameterType="Long" resultMap="RaceLanqiaoTypeResult">
        <include refid="selectRaceLanqiaoTypeVo"/>
        where id = #{id}  and is_deleted = 0
        order by sort asc
    </select>

    <insert id="insertRaceLanqiaoType" parameterType="com.buis.model.domain.RaceLanqiaoType" useGeneratedKeys="true" keyProperty="id">
        insert into race_lanqiao_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="sort != null">sort,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="sort != null">#{sort},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateRaceLanqiaoType" parameterType="com.buis.model.domain.RaceLanqiaoType">
        update race_lanqiao_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRaceLanqiaoTypeById" parameterType="Long">
        update race_lanqiao_type
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteRaceLanqiaoTypeByIds" parameterType="String">
        update race_lanqiao_type
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>