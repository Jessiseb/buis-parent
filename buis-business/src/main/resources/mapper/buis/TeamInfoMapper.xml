    <delete id="deleteTeamInfoById" parameterType="java.lang.Long">
        update team_info
        set is_deleted = 1
        where id = #{id}
    </delete>
    <delete id="deleteTeamInfoByIds" parameterType="String">
        update team_info
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="selectTeamInfoByIds" parameterType="java.lang.Long" resultType="com.buis.domain.TeamInfo">
        <include refid="selectTeamInfoVo"/>
        where t1.id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
    <select id="getTeamInfoList" resultType="com.buis.domain.TeamInfo">
        <include refid="selectTeamInfoVo"/>
        <where>
            t1.is_deleted = 0 and t1.is_publish = 'Y'
            <if test="race != null and race != ''">and t1.race = #{race}</if>
            <if test="name != null  and name != ''">and t1.name like concat('%', #{name}, '%')</if>
            <if test="type != null and type != ''">and t1.type = #{type}</if>
            <if test="description != null  and description != '' ">and t1.description like concat('%', #{description},
