    <sql id="selectTeamInfoVo">
        select t1.id,
               t1.leader,
               t1.race,
               t5.name as race_name,
               t1.name,
               t1.type,
               t1.description,
               t1.leader_name,
               t1.phone,
               t1.s_class,
               t2.name as s_college,
               t1.teacher1,
               t1.teacher2,
               t3.name as t1_college,
               t4.name as t2_college,
               t1.declaration_url,
               t1.mid_url,
               t1.closure_url,
               t1.r_rank,
               t1.status,
               t1.reason,
               t1.start,
               t1.end,
               t1.number,
               t1.request,
               t1.is_publish,
               t1.is_deleted,
               t1.create_time,
               t1.update_time,
               u1.name as t1_name,
               u2.name as t2_name
        from team_info t1
                 left join t_college_major t2 on t1.college = t2.id
                 left join t_college_major t3 on t1.teacher1_college = t3.id
                 left join t_college_major t4 on t1.teacher2_college = t4.id
                 left join race_info t5 on t1.race = t5.id
                 left join user_info u1 on t1.teacher1 = u1.id
                 left join user_info u2 on t1.teacher2 = u2.id
    </sql>

    <select id="selectTeamInfoList" parameterType="com.buis.domain.TeamInfo" resultMap="TeamInfoResult">
        <include refid="selectTeamInfoVo"/>
        <where>
            t1.is_deleted = 0
            <if test="race != null and race != ''">and t1.race = #{race}</if>
            <if test="name != null  and name != ''">and t1.name like concat('%', #{name}, '%')</if>
            <if test="type != null and type != ''">and t1.type = #{type}</if>
            <if test="description != null  and description != '' ">and t1.description like concat('%', #{description},
                '%')
            </if>
            <if test="leader != null ">and t1.leader = #{leader}</if>
            <if test="leaderName != null  and leaderName != ''">and t1.leader_name like concat('%', #{leaderName}, '%')
            </if>
            <if test="isPublish != null and isPublish != ''">and t1.is_publish = #{isPublish}</if>
            <if test="phone != null  and phone != ''">and t1.phone like concat('%', #{phone}, '%')</if>
            <if test="sClass != null  and sClass != ''">and t1.s_class like concat('%', #{sClass}, '%')</if>
            <if test="college != null and college != ''">and t1.college = #{college}</if>
        </where>
    </select>

    <select id="selectTeamInfoById" parameterType="Long" resultMap="TeamInfoResult">
        <include refid="selectTeamInfoVo"/>
        where t1.id = #{id} and t1.is_deleted = 0
    </select>

    <select id="getCountJoin" resultType="java.lang.Integer">
        select count(1)
        from team_info t1
        <where>
            t1.is_deleted = 0
            <if test="raceId != null">and t1.race = #{raceId}</if>
            <if test="team != null">and t1.team = #{team}</if>
            <if test="userId != null">and t1.leader = #{userId}</if>
        </where>
    </select>

    <select id="selectTeamInfoByUserId" resultType="com.buis.domain.TeamInfo">
        <include refid="selectTeamInfoVo"/>
        where t1.leader = #{userId} and t1.is_deleted = 0
    </select>

