<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.TeamMemberTeacherMapper">
    
    <resultMap type="TeamMemberTeacher" id="TeamMemberTeacherResult">
        <result property="id"    column="id"    />
        <result property="race"    column="race"    />
        <result property="team"    column="team"    />
        <result property="teacher"    column="teacher"    />
        <result property="decider"    column="decider"    />
        <result property="isChoosed"    column="is_choosed"    />
        <result property="reason"    column="reason"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>


    <sql id="selectTeamMemberTeacherVo">
        select id, race, team, teacher, decider, is_choosed, reason, is_deleted, create_time, update_time from team_member_teacher
    </sql>


    <!--查询队伍老师管理列表-->
    <select id="selectTeamMemberTeacherList" parameterType="com.buis.domain.TeamMemberTeacher" resultMap="TeamMemberTeacherResult">
    <include refid="selectTeamMemberTeacherVo"/>
    <where>
        SET is_deleted = 0
        <if test="id != null "> AND id = #{id}</if>
        <if test="race != null "> AND race = #{race}</if>
        <if test="team != null "> AND team = #{team}</if>
        <if test="teacher != null "> AND teacher = #{teacher}</if>
        <if test="decider != null "> AND decider = #{decider}</if>
        <if test="isChoosed != null "> AND is_choosed = #{isChoosed}</if>
        <if test="reason != null  and reason != ''"> AND reason LIKE concat('%', #{reason}, '%')</if>
    </where>
</select>


    <!--查询队伍老师管理-->
    <select id="selectTeamMemberTeacherById" parameterType="Long" resultMap="TeamMemberTeacherResult">
        <include refid="selectTeamMemberTeacherVo"/>
            /*去除报红问题即ok*/
         WHERE id = #{id}
         AND is_deleted = 0
    </select>





    <!--插入队伍老师信息管理-->
    <insert id="insertTeamMemberTeacher" parameterType="com.buis.domain.TeamMemberTeacher" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO team_member_teacher

        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="race != null">race,</if>
            <if test="team != null">team,</if>
            <if test="teacher != null">teacher,</if>
            <if test="decider != null">decider,</if>
            <if test="isChoosed != null">is_choosed,</if>
            <if test="reason != null">reason,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>

        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="race != null">#{race},</if>
            <if test="team != null">#{team},</if>
            <if test="teacher != null">#{teacher},</if>
            <if test="decider != null">#{decider},</if>
            <if test="isChoosed != null">#{isChoosed},</if>
            <if test="reason != null">#{reason},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>

    </insert>





    <!--更新队伍老师管理-->
    <update id="updateTeamMemberTeacher" parameterType="com.buis.domain.TeamMemberTeacher">
        Update  team_member_teacher
        <trim prefix="SET" suffixOverrides=",">
            <if test="race != null">race = #{race},</if>
            <if test="team != null">team = #{team},</if>
            <if test="teacher != null">teacher = #{teacher},</if>
            <if test="decider != null">decider = #{decider},</if>
            <if test="isChoosed != null">is_choosed = #{isChoosed},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        WHERE id = #{id}
    </update>








    <!--对队伍老师信息进行逻辑删除   ok 但是实体类报红-->
    <update id="deleteTeamMemberTeacherById" parameterType="Long">
        UPDATE team_member_teacher
        SET is_deleted  = 1
        WHERE id = #{id}
    </update>



        <!--批量对队伍老师信息进行逻辑删除   ok-->
    <update id="deleteTeamMemberTeacherByIds" parameterType="Long[]" >
            UPDATE  team_member_teacher
            SET is_deleted = 1
            WHERE id  IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>


</mapper>