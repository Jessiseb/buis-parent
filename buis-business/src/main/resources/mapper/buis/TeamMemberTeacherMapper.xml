<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.TeamMemberTeacherMapper">
    
    <resultMap type="com.buis.model.vo.TeamMemberTeacherVo" id="TeamMemberTeacherResult">
        <result property="id"    column="id"    />
        <result property="race"    column="race"    />
        <result property="raceName"    column="race_name"    />
        <result property="team"    column="team"    />
        <result property="teacher"    column="teacher"    />
        <result property="decider"    column="decider"    />
        <result property="isChoosed"    column="is_choosed"    />
        <result property="reason"    column="reason"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTeamMemberTeacherVo">
        select t1.id,
               t1.race,
               t1.team,
               t3.name as race_name,
               t1.teacher,
               t1.decider,
               t1.is_choosed,
               t1.reason,
               t1.is_deleted,
               t1.create_time,
               t1.update_time
        from team_member_teacher t1
                 left join race_info t3 on t1.race = t3.id
    </sql>

    <select id="selectTeamMemberTeacherList" parameterType="com.buis.model.domain.TeamMemberTeacher" resultMap="TeamMemberTeacherResult">
        <include refid="selectTeamMemberTeacherVo"/>
        <where>
            t1.is_deleted = 0
            <if test="id != null "> and t1.id = #{id}</if>
            <if test="race != null "> and t1.race = #{race}</if>
            <if test="team != null "> and t1.team = #{team}</if>
            <if test="teacher != null "> and t1.teacher = #{teacher}</if>
            <if test="decider != null "> and t1.decider = #{decider}</if>
            <if test="isChoosed != null "> and t1.is_choosed = #{isChoosed}</if>
            <if test="reason != null  and reason != ''"> and t1.reason like concat('%', #{reason}, '%')</if>
        </where>
    </select>
    
    <select id="selectTeamMemberTeacherById" parameterType="Long" resultMap="TeamMemberTeacherResult">
        <include refid="selectTeamMemberTeacherVo"/>
        where t1.id = #{id}  and t1.is_deleted = 0
    </select>
    <select id="getCount" resultType="java.lang.Long">
        SELECT
            COUNT(team_member_teacher.teacher) AS teamNumbers,
            (SELECT GROUP_CONCAT(user_info.`name`)
             FROM user_info
                      INNER JOIN team_member_teacher ON user_info.id = team_member_teacher.teacher
             WHERE team_member_teacher.team = team_info.id AND team_member_teacher.is_deleted = 0) AS teacherNames
        FROM
            team_info
                LEFT JOIN
            team_member_teacher ON team_info.id = team_member_teacher.team
        WHERE
            team_info.id = #{id} AND team_member_teacher.is_deleted = 0
    </select>

    <select id="selectTeamMyInstruct" resultType="com.buis.model.domain.TeamMemberTeacher">
        <include refid="selectTeamMemberTeacherVo"/>
        where t1.teacher = #{id}  and t1.is_deleted = 0
    </select>

    <select id="getTeachersByRaceId" resultType="java.lang.Long">
        select distinct teacher from team_member_teacher where race = #{id} and is_deleted = 0
    </select>

    <insert id="insertTeamMemberTeacher" parameterType="com.buis.model.domain.TeamMemberTeacher" useGeneratedKeys="true" keyProperty="id">
        insert into team_member_teacher
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="race != null">race,</if>
            <if test="team != null">team,</if>
            <if test="teacher != null">teacher,</if>
            <if test="decider != null">decider,</if>
            <if test="isChoosed != null">is_choosed,</if>
            <if test="reason != null">reason,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="race != null">#{race},</if>
            <if test="team != null">#{team},</if>
            <if test="teacher != null">#{teacher},</if>
            <if test="decider != null">#{decider},</if>
            <if test="isChoosed != null">#{isChoosed},</if>
            <if test="reason != null">#{reason},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>
    <insert id="insertTeamMemberTeacherBatch" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="id">
        insert into team_member_teacher (race, team, teacher, decider, is_choosed, reason)
        values
        <foreach collection="list" item="item" separator=",">
            (
            #{item.race},
            #{item.team},
            #{item.teacher},
            #{item.decider},
            #{item.isChoosed},
            #{item.reason}

            )
        </foreach>
    </insert>
    <insert id="insertTeamMemberTeacherByList">
        <foreach collection="list" item="item" separator=";">
            insert into team_member_teacher
