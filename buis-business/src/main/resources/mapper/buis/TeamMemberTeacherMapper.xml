            </trim>
        </foreach>
    </insert>


    <update id="updateTeamMemberTeacher" parameterType="com.buis.model.domain.TeamMemberTeacher">
        update team_member_teacher
        <trim prefix="SET" suffixOverrides=",">
            <if test="race != null">race = #{race},</if>
            <if test="team != null">team = #{team},</if>
            <if test="student != null">student = #{student},</if>
            <if test="decider != null">decider = #{decider},</if>
            <if test="isChoosed != null">is_choosed = #{isChoosed},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>


    <delete id="deleteTeamMemberTeacherById" parameterType="Long">
        update team_member_teacher
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteTeamMemberTeacherByIds" parameterType="String">
        update team_member_teacher
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <delete id="deleteTeamMemberTeacherByTeamAndTeacher">
        update team_member_teacher
        set is_deleted = 1
        where team = #{team} and teacher = #{user}
    </delete>
    <delete id="deleteTeamMemberTeacherByTeam">
        update team_member_teacher
        set is_deleted = 1
        where team = #{team}
    </delete>
    <select id="getGuideCount" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM team_member_teacher
        WHERE teacher = #{id} AND is_deleted = 0
    </select>
    <select id="getJoinCountByTeamId" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM team_member_teacher
        WHERE team = #{id}
          AND is_deleted = 0
          AND is_choosed = 1
    </select>
    <select id="selectJoinTeamByTeacherId" resultType="java.lang.Long">
        SELECT team
        FROM team_member_teacher
        WHERE teacher = #{userId}
        AND is_deleted = 0
        AND is_choosed = 1
        <if test="race != null and race != ''">and race = #{race}</if>
        <if test="name != null and name != ''">and name = #{name}</if>
    </select>
    <select id="selectTeamInfoByIds" parameterType="java.lang.Long" resultType="com.buis.model.domain.TeamInfo">
        <include refid="selectTeamMemberTeacherVo"/>
        FROM team_info
        WHERE t1.id IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND t1.is_deleted = 0
    </select>

    <select id="getCountJoin" resultType="java.lang.Integer">
        select count(1)
        from team_member_teacher
        <where>
            is_deleted = 0 and is_choosed = 1
            <if test="raceId != null">and race = #{raceId}</if>
            <if test="userId != null">and teacher = #{userId}</if>
            <if test="team != null">and team = #{team}</if>
        </where>
    </select>
    <select id="getMemberTeachersByTeamId" resultType="java.lang.Long">
        select teacher from team_member_teacher where team = #{id} and is_deleted = 0
    </select>
    <select id="selectTeamMemberTeacherByTeamId" resultType="com.buis.model.domain.TeamMemberTeacher">
        select * from team_member_teacher where team = #{id} and is_deleted = 0
