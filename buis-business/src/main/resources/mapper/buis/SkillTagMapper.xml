<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.SkillTagMapper">
    
    <resultMap type="SkillTag" id="SkillTagResult">
        <result property="id"    column="id"    />
        <result property="tagName"    column="tag_name"    />
        <result property="category"    column="category"    />
        <result property="description"    column="description"    />
        <result property="isActive"    column="is_active"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSkillTagVo">
        select id, tag_name, category, description, is_active, create_time, update_time from skill_tag
    </sql>

    <select id="selectSkillTagList" parameterType="SkillTag" resultMap="SkillTagResult">
        <include refid="selectSkillTagVo"/>
        <where>
            is_deleted = 0
            <if test="tagName != null  and tagName != ''"> and tag_name like concat('%', #{tagName}, '%')</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="isActive != null "> and is_active = #{isActive}</if>
        </where>
    </select>
    
    <select id="selectSkillTagById" parameterType="Long" resultMap="SkillTagResult">
        <include refid="selectSkillTagVo"/>
        where id = #{id}  and is_deleted = 0
    </select>

    <insert id="insertSkillTag" parameterType="SkillTag" useGeneratedKeys="true" keyProperty="id">
        insert into skill_tag
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tagName != null">tag_name,</if>
            <if test="category != null">category,</if>
            <if test="description != null">description,</if>
            <if test="isActive != null">is_active,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tagName != null">#{tagName},</if>
            <if test="category != null">#{category},</if>
            <if test="description != null">#{description},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSkillTag" parameterType="SkillTag">
        update skill_tag
        <trim prefix="SET" suffixOverrides=",">
            <if test="tagName != null">tag_name = #{tagName},</if>
            <if test="category != null">category = #{category},</if>
            <if test="description != null">description = #{description},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSkillTagById" parameterType="Long">
        update skill_tag
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteSkillTagByIds" parameterType="String">
        update skill_tag
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <select id="selectAllActiveTags" resultMap="SkillTagResult">
        <include refid="selectSkillTagVo"/>
        where is_active = 1
        order by tag_name
    </select>

    <!-- 获取热门技能统计（前7条） -->
    <select id="selectTop7StudentSkillStats" resultType="com.buis.model.vo.StudentSkillStatVo">
        SELECT
            st.tag_name as skillName,
            COUNT(DISTINCT us.user_id) as studentCount
        FROM skill_tag st
                 LEFT JOIN user_skill us ON st.id = us.skill_tag_id

        WHERE st.is_active = 1
        GROUP BY st.id, st.tag_name
        ORDER BY
            COUNT(DISTINCT us.user_id) DESC,
            st.create_time DESC
            LIMIT 7
    </select>


</mapper>