<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.UserInfoMapper">
    
    <resultMap type="com.buis.vo.UserInfoVo" id="UserInfoResult">
        <result property="id"    column="id"    />
        <result property="number"    column="number"    />
        <result property="email"    column="email"    />
        <result property="phone"    column="phone"    />
        <result property="name"    column="name"    />
        <result property="description"    column="description"    />
        <result property="sex"    column="sex"    />
        <result property="college"    column="college"    />
        <result property="major"    column="major"    />
        <result property="collegeName"    column="college_name"    />
        <result property="majorName"    column="major_name"    />
        <result property="title"    column="title"    />
        <result property="isDisabled"    column="is_disabled"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="isTeacher"    column="is_teacher"    />
    </resultMap>

    <sql id="selectUserInfoVo">
        select t1.id, t1.number,  t1.email, t1.phone, t1.name, t1.description, t1.sex, t1.college,t1.major, t1.is_teacher,t2.name AS major_name,t3.name AS college_name, t1.title, t1.is_disabled, t1.is_deleted, t1.create_time, t1.update_time
        from user_info t1
        LEFT JOIN
        t_college_major t2 ON t1.major = t2.id
        LEFT JOIN
             t_college_major t3 ON t1.college = t3.id
    </sql>

    <select id="selectUserInfoList" parameterType="com.buis.domain.UserInfo" resultMap="UserInfoResult">
        <include refid="selectUserInfoVo"/>
        <where>
            t1.is_deleted = 0
            <if test="id != null "> and t1.id = #{id}</if>
            <if test="number != null  and number != ''"> and t1.number = #{number}</if>
            <if test="password != null  and password != ''"> and t1.password = #{password}</if>
            <if test="email != null  and email != ''"> and t1.email = #{email}</if>
            <if test="phone != null  and phone != ''"> and t1.phone = #{phone}</if>
            <if test="name != null  and name != ''"> and t1.name like concat('%', #{name}, '%')</if>
            <if test="description != null  and description != ''"> and t1.description like concat('%', #{description}, '%')</if>
            <if test="sex != null and sex !=''"> and t1.sex = #{sex}</if>
            <if test="college != null and sex != ''"> and t1.college = #{college}</if>
            <if test="major != null and major != ''">and t1.major = #{major}</if>
            <if test="isTeacher != null">and t1.is_teacher=#{isTeacher}</if>
            <if test="title != null and title != ''">and t1.title = #{title}</if>
            <if test="isDisabled != null and isDisabled != ''">and t1.is_disabled = #{isDisabled}</if>
        </where>
    </select>

    <select id="selectUserInfoById" parameterType="Long" resultMap="UserInfoResult">
        <include refid="selectUserInfoVo"/>
        where t1.id = #{id} and t1.is_deleted = 0
    </select>

    <select id="getLoginInfoByUserId" resultType="com.buis.domain.UserInfo">
        select id, email, password, is_teacher
        from user_info
        where id = #{id} and is_deleted = 0
    </select>

    <select id="selectUserInfoByIds" parameterType="java.util.List" resultType="com.buis.domain.UserInfo">
        <include refid="selectUserInfoVo"/>
        WHERE t1.id IN
        <foreach item="id" collection="list" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND t1.is_deleted = 0
    </select>
    <select id="getLoginInfoByEmail" resultType="com.buis.domain.UserInfo">
        select id, email, password,is_teacher
        from user_info
        where email = #{email} and is_deleted = 0
    </select>
    <select id="selectUserInfoBynumber" resultType="com.buis.domain.UserInfo">
        select id, number, email, phone, name, description, sex, college, major, title, is_disabled, is_deleted, create_time, update_time
        from user_info
        where number = #{number} and is_deleted = 0
    </select>
    <select id="selectUserInfoByName" resultType="com.buis.vo.UserInfoVo">
        select id, number, email, phone, name, description, sex, college, major, title, is_disabled, is_deleted, create_time, update_time
        from user_info
        where name = #{name} and is_deleted = 0
    </select>
    <select id="selectTeachers" resultType="com.buis.vo.UserInfoVo">
        select id,
               number,
               email,
               phone,
               name,
               description,
               sex,
               college,
               major,
               title
        from user_info
        where is_teacher = #{isTeacher} and is_deleted = 0
    </select>
    <insert id="insertUserInfo" parameterType="com.buis.domain.UserInfo" useGeneratedKeys="true" keyProperty="id">
        insert into user_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="number != null and number != ''">number,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="email != null and email != ''">email,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="sex != null">sex,</if>
            <if test="college != null">college,</if>
            <if test="major != null">major,</if>
            <if test="title != null">title,</if>
            <if test="isTeacher != null ">is_teacher,</if>
            <if test="isDisabled != null">is_disabled,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="number != null and number != ''">#{number},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="email != null and email != ''">#{email},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="sex != null">#{sex},</if>
            <if test="college != null">#{college},</if>
            <if test="major != null">#{major},</if>
            <if test="title != null">#{title},</if>
            <if test="isTeacher != null ">#{isTeacher},</if>
            <if test="isDisabled != null">#{isDisabled},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>


    <update id="updateUserInfo" parameterType="com.buis.domain.UserInfo">
        update user_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="number != null and number != ''">number = #{number},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="email != null and email != ''">email = #{email},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="sex != null">sex = #{sex},</if>
            <if test="college != null">college = #{college},</if>
            <if test="major != null">major = #{major},</if>
            <if test="isTeacher != null ">is_teacher=#{isTeacher},</if>
            <if test="title != null">title = #{title},</if>
            <if test="isDisabled != null">is_disabled = #{isDisabled},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}

    </update>


    <delete id="deleteUserInfoById" parameterType="java.lang.Long">
        update user_info
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteUserInfoByIds" parameterType="java.lang.Long">
        update user_info
        set is_deleted = 1
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>