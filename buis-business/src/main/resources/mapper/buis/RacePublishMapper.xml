            <if test="particpationWay != null  and particpationWay != ''"> and particpation_way = #{particpationWay}</if>
            <if test="capacity != null "> and capacity = #{capacity}</if>
            <if test="teacher != null  and teacher != ''"> and teacher = #{teacher}</if>
