<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.RaceInfoMapper">
    
    <resultMap type="com.buis.vo.RaceInfoVo" id="RaceInfoResult">
        <result property="id"    column="id"    />
        <result property="parentTid"    column="parent_tid"    />
        <result property="sonTid"    column="son_tid"    />
        <result property="sonName"    column="son_name"    />
        <result property="parentName"    column="parent_name"    />
        <result property="name"    column="name"    />
        <result property="description"    column="description"    />
        <result property="joinStart"    column="join_start"    />
        <result property="joinEnd"    column="join_end"    />
        <result property="raceStart"    column="race_start"    />
        <result property="raceEnd"    column="race_end"    />
        <result property="status"    column="status"    />
        <result property="level"    column="level"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="isLanqiao"    column="is_lanqiao"    />
        <collection property="rewardList" ofType="com.buis.domain.Reward">
            <id property="id" column="id"></id>
            <result property="race" column="race"></result>
            <result property="rRank" column="rRank"></result>
            <result property="name" column="name"></result>
            <result property="quantity" column="quantity"></result>
            <result property="isDeleted" column="is_deleted"></result>
        </collection>
    </resultMap>

    <resultMap id="RaceInfoRewardResult" type="com.buis.vo.RaceInfoVo" extends="RaceInfoResult">
        <collection property="rewardList" ofType="com.buis.domain.Reward" column="id" select="selectRewardList" />
    </resultMap>

    <resultMap type="com.buis.domain.Reward" id="RewardResult">
        <result property="id"    column="id"    />
        <result property="race"    column="race"    />
        <result property="rRank"    column="r_rank"    />
        <result property="name"    column="name"    />
        <result property="quantity"    column="quantity"    />
        <result property="remark"    column="remark"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectRaceInfoVo">
        select t1.id, t1.parent_tid,ti.is_lanqiao, t1.son_tid,t2.name as son_name,t3.name as parent_name, t1.name, t1.description, t1.join_start,
               t1.join_end, t1.race_start, t1.race_end, t1.status, t1.level, t1.is_deleted, t1.create_time, t1.update_time
        from race_info t1
left join race_type t2 on t2.id = t1.son_tid
        left join race_type t3 on t3.id = t2.parent_id
    </sql>

    <select id="selectRaceInfoList" parameterType="com.buis.vo.RaceInfoVo" resultMap="RaceInfoResult">
        <include refid="selectRaceInfoVo"/>
        <where>
            t1.is_deleted = 0
            <if test="id != null "> and t1.id = #{id}</if>
            <if test="parentTid != null "> and t1.parent_tid = #{parentTid}</if>
            <if test="sonTid != null "> and t1.son_tid = #{sonTid}</if>
            <if test="name != null  and name != ''"> and t1.name like concat('%', #{name}, '%')</if>
            <if test="description != null  and description != ''"> and t1.description like concat('%', #{description}, '%')</if>
            <if test="joinStart != null "> and t1.join_start &gt;= #{joinStart}</if>
            <if test="joinEnd != null "> and t1.join_end &lt;= #{joinEnd}</if>
            <if test="raceStart != null "> and t1.race_start &gt;= #{raceStart}</if>
            <if test="raceEnd != null "> and t1.race_end &lt;= #{raceEnd}</if>
            <if test="status != null "> and t1.status = #{status}</if>
            <if test="level != null "> and t1.level = #{level}</if>
            <if test="isLanqiao != null "> and t1.is_lanqiao = #{isLanqiao}</if>
        </where>
    </select>
    
    <select id="selectRaceInfoById" parameterType="Long" resultMap="RaceInfoRewardResult">
        <include refid="selectRaceInfoVo"/>
        where t1.id = #{id} and t1.is_deleted = 0
    </select>

    <select id="selectRewardList" resultMap="RewardResult">
        select id, race, r_rank, name, quantity, remark, is_deleted, create_time, update_time
        from t_reward
        where race = #{race} and is_deleted = 0
    </select>

    <insert id="insertRaceInfo" parameterType="com.buis.domain.RaceInfo" useGeneratedKeys="true" keyProperty="id">
        insert into race_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentTid != null">parent_tid,</if>
            <if test="sonTid != null">son_tid,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="joinStart != null">join_start,</if>
            <if test="joinEnd != null">join_end,</if>
            <if test="raceStart != null">race_start,</if>
            <if test="raceEnd != null">race_end,</if>
            <if test="status != null">status,</if>
            <if test="level != null">level,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentTid != null">#{parentTid},</if>
            <if test="sonTid != null">#{sonTid},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="joinStart != null">#{joinStart},</if>
            <if test="joinEnd != null">#{joinEnd},</if>
            <if test="raceStart != null">#{raceStart},</if>
            <if test="raceEnd != null">#{raceEnd},</if>
            <if test="status != null">#{status},</if>
            <if test="level != null">#{level},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateRaceInfo" parameterType="com.buis.domain.RaceInfo">
        update race_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentTid != null">parent_tid = #{parentTid},</if>
            <if test="sonTid != null">son_tid = #{sonTid},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="joinStart != null">join_start = #{joinStart},</if>
            <if test="joinEnd != null">join_end = #{joinEnd},</if>
            <if test="raceStart != null">race_start = #{raceStart},</if>
            <if test="raceEnd != null">race_end = #{raceEnd},</if>
            <if test="status != null">status = #{status},</if>
            <if test="level != null">level = #{level},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRaceInfoById" parameterType="Long">
        update race_info
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteRaceInfoByIds" parameterType="String">
        update race_info
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteRewardByRaces" parameterType="String">
        update t_reward
        set is_deleted = 1
        where race in
        <foreach item="race" collection="array" open="(" separator="," close=")">
            #{race}
        </foreach>
    </delete>

    <delete id="deleteRewardByRace" parameterType="Long">
        update t_reward
        set is_deleted = 1
        where race = #{race}
    </delete>

    <insert id="batchReward">
        insert into t_reward( id, race, r_rank, name, quantity, remark, is_deleted, create_time, update_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.race}, #{item.rRank}, #{item.name}, #{item.quantity}, #{item.remark}, #{item.isDeleted}, #{item.createTime}, #{item.updateTime})
        </foreach>
    </insert>
</mapper>