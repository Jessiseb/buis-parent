    <sql id="selectRaceInfoVo">
        select t1.id,
               t1.parent_tid,
               t1.son_tid,
               t1.teacher_name,
               t2.name as son_name,
               t3.name as parent_name,
               t1.name,
               t1.description,
               t1.join_start,
               t1.join_end,
               t1.race_start,
               t1.race_end,
               t1.score_start,
               t1.score_end,
               t1.race_type,
               t1.status,
               t1.review_status,
               t1.level,
               t1.seniority,
               t1.desc_url,
               t1.department,
               t1.organizers,
               t1.course,
               t1.place,
               t1.fund,
               t1.major_count,
               t1.is_deleted,
               t1.create_time,
               t1.update_time
        from race_info t1
                 left join race_type t2 on t2.id = t1.son_tid
                 left join race_type t3 on t3.id = t2.parent_id
    </sql>

    <select id="selectRaceInfoList" parameterType="com.buis.vo.RaceInfoVo" resultMap="RaceInfoRewardResult">
