<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.AwardMapper">

    <resultMap type="com.buis.vo.AwardVo" id="AwardResult">
        <result property="id" column="id"/>
        <result property="raceId" column="race_id"/>
        <result property="raceName" column="race_name"/>
        <result property="teamId" column="team_id"/>
        <result property="year" column="year"/>
        <result property="name" column="name"/>
        <result property="awardLevel" column="award_level"/>
        <result property="teachers" column="teachers"/>
        <result property="awardProject" column="award_project"/>
        <result property="awardDate" column="award_date"/>
        <result property="updateTime" column="update_time"/>
        <result property="createTime" column="create_time"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <resultMap id="AwardraceResult" type="com.buis.vo.AwardVo" extends="AwardResult">
        <result property="raceId" column="race_id"/>
        <result property="winners" column="winners"/>
    </resultMap>

    <sql id="selectAwardVo">
        select t1.id,
               t1.race_id,
               t1.name,
               t2.name as race_name,
               t1.team_id,
               t1.year,
               t1.award_level,
               t1.teachers,
               t1.award_project,
               t1.award_date,
               t1.update_time,
               t1.create_time,
               t1.is_deleted
        from award t1
                 left join race_info t2 on t1.race_id = t2.id
    </sql>

    <sql id="selectAwardrace">
        SELECT race_name,
               teachers,
               winners,
               race_id,
               name
        FROM award
    </sql>

    <select id="selectAwardRaceList" resultMap="AwardraceResult">
        <include refid="selectAwardrace"/>
        <where>
            <if test="raceId != null "> and race_id = #{raceId}</if>
        </where>
    </select>

    <select id="selectAwardList" parameterType="com.buis.vo.AwardVo" resultMap="AwardResult">
        <include refid="selectAwardVo"/>
        <where>
            t1.is_deleted = 0
            <if test="raceId != null ">and t1.race_id = #{raceId}</if>
            <if test="teamId != null ">and t1.team_id = #{teamId}</if>
            <if test="raceName != null  and raceName != ''">and t2.name = #{raceName}</if>
            <if test="name != null  and name != ''">and t1.name like concat('%', #{name}, '%')</if>
            <if test="year != null  and year != ''">and t1.year like concat('%', #{year}, '%')</if>
            <if test="awardLevel != null  and awardLevel != ''">and t1.award_level = #{awardLevel}</if>
            <if test="teachers != null  and teachers != ''">and t1.teachers = #{teachers}</if>
            <if test="awardProject != null  and awardProject != ''">and t1.award_project = #{awardProject}</if>
            <if test="awardDate != null ">and award_date = #{awardDate}</if>
        </where>
        order by t1.create_time desc
    </select>


    <select id="selectAwardByTeam" resultMap="AwardResult">
        select a.race_id,a.team_id,a.year,a.award_level,a.teachers,a.award_project,a.award_date,a.name
        from award as a
        where team_id = #{teamId} and is_deleted = 0
    </select>

    <select id="selectAwardByNameAndRace" resultType="com.buis.domain.Award">
        select a.race_id, a.name, a.year, a.award_level, a.teachers,a.award_project,a.award_date
        from award as a
        where name = #{name}
          and race_id = #{raceId}
          and is_deleted = 0
    </select>
    <select id="selectAwardById" resultType="com.buis.vo.AwardVo">
        <include refid="selectAwardVo"/>
        where t1.id = #{id}
    </select>

    <insert id="insertAward" parameterType="com.buis.vo.AwardVo">
        insert into award
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="raceId != null">race_id,</if>
            <if test="teamId != null">team_id,</if>
            <if test="name != null">name,</if>
            <if test="year != null">year,</if>
            <if test="awardLevel != null">award_level,</if>
            <if test="teachers != null">teachers,</if>
            <if test="awardProject != null">award_project,</if>
            <if test="awardDate != null">award_date,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="raceName != null">race_name,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="raceId != null">#{raceId},</if>
            <if test="teamId != null">#{teamId},</if>
            <if test="name != null">#{name},</if>
            <if test="year != null">#{year},</if>
            <if test="awardLevel != null">#{awardLevel},</if>
            <if test="teachers != null">#{teachers},</if>
            <if test="awardProject != null">#{awardProject},</if>
            <if test="awardDate != null">#{awardDate},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="raceName != null">#{raceName},</if>
        </trim>
    </insert>

    <update id="updateAward" parameterType="com.buis.domain.Award">
        update award
        <trim prefix="SET" suffixOverrides=",">
            <if test="raceId != null">race_id = #{raceId},</if>
            <if test="teamId != null">team_id = #{teamId},</if>
            <if test="year != null">year = #{year},</if>
            <if test="name != null">name = #{name},</if>
            <if test="awardLevel != null">award_level = #{awardLevel},</if>
            <if test="teachers != null">teachers = #{teachers},</if>
            <if test="awardProject != null">award_project = #{awardProject},</if>
            <if test="awardDate != null">award_date = #{awardDate},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAwardById" parameterType="Long">
        update award
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteAwardByIds" parameterType="String">
        update award
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


</mapper>