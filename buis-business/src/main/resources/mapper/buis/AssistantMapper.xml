<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buis.mapper.AssistantMapper">
    
    <resultMap type="com.buis.model.vo.AssistantVo" id="AssistantResult">
        <result property="id"    column="id"    />
        <result property="student"    column="student"    />
        <result property="race"    column="race"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectAssistantVo">
        select id, student, race, is_deleted, create_time, update_time from t_assistant
    </sql>

    <select id="selectAssistantList" parameterType="com.buis.model.domain.Assistant" resultMap="AssistantResult">
        <include refid="selectAssistantVo"/>
        <where>
            is_deleted = 0
            <if test="id != null "> and id = #{id}</if>
            <if test="student != null "> and student = #{student}</if>
            <if test="race != null "> and race = #{race}</if>
        </where>
    </select>
    
    <select id="selectAssistantById" parameterType="Long" resultMap="AssistantResult">
        <include refid="selectAssistantVo"/>
        where id = #{id}  and is_deleted = 0
    </select>

    <select id="fuzzyQuery" parameterType="java.lang.String" resultMap="AssistantResult">
        SELECT t_assistant.* FROM t_assistant
        JOIN user_info ON t_assistant.student = user_info.id
        <where>
            t_assistant.is_deleted = 0
            <if test="name != 'null' and name != ''">and user_info.name LIKE CONCAT('%', #{name}, '%')</if>
        </where>
    </select>
    <select id="selectAssistantListByRace" resultType="com.buis.model.vo.UserInfoVo">
        select user_info.id,
               user_info.name
        from t_assistant
        JOIN user_info ON t_assistant.student = user_info.id
        where t_assistant.race = #{id} and t_assistant.is_deleted = 0
    </select>

    <insert id="insertAssistant" parameterType="com.buis.model.domain.Assistant" useGeneratedKeys="true" keyProperty="id">
        insert into t_assistant
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="student != null">student,</if>
            <if test="race != null">race,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="student != null">#{student},</if>
            <if test="race != null">#{race},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateAssistant" parameterType="com.buis.model.domain.Assistant">
        update t_assistant
        <trim prefix="SET" suffixOverrides=",">
            <if test="student != null">student = #{student},</if>
            <if test="race != null">race = #{race},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAssistantById" parameterType="Long">
        update t_assistant
        set is_deleted = 1
        where id = #{id}
    </delete>

    <delete id="deleteAssistantByIds" parameterType="String">
        update t_assistant
        set is_deleted = 1
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>