# ===== 后端敏感配置示例 =====
# 复制为 .env（或 application-local.yml）后填入真实值，切勿提交真实值到仓库。
# 部署时通过环境变量注入；本地开发推荐用 IDE 的 Run Configuration / .env 插件加载。

# ---------- 数据库 ----------
# 43.136.119.58 / 119.91.227.162 / 42.194.233.38 均为生产与测试库地址，请按需替换
DB_HOST=
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=
REDIS_PORT=6338
REDIS_PASSWORD=

# ---------- 令牌与签名 ----------
# 生成方式：openssl rand -base64 48
TOKEN_SECRET=
SA_TOKEN_JWT_SECRET=

# ---------- 阿里云百炼 ----------
# https://bailian.console.aliyun.com/  →  API-KEY 管理
ALIYUN_AI_API_KEY=

# ---------- 阿里云 OSS ----------
# https://ram.console.aliyun.com/manage/ak  →  AccessKey
ALIYUN_OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=chuangxin-bucket

# ---------- Coze ----------
# https://www.coze.cn/  →  个人访问令牌
COZE_TOKEN=

# ---------- 百度文心智能体 ----------
# https://agents.baidu.com/  →  应用 ID 与密钥
WENXIN_APP_ID=
WENXIN_APP_SECRET_KEY=

# ---------- 邮件（SMTP） ----------
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Druid 监控台 ----------
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=
